---------------------------------------------------
-- PLAYER SEARCH
---------------------------------------------------

local function getPlayerByName(name)
for _, p in ipairs(players:GetPlayers()) do
if string.lower(p.Name):find(string.lower(name)) then
return p
end
end
return nil
end

