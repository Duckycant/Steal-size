local function collect(folderName)
local folder = workspace:FindFirstChild(folderName)
if folder then
for _, v in ipairs(folder:GetDescendants()) do
if v:IsA("BasePart") then
hrp.CFrame = v.CFrame + Vector3.new(0,2,0)
task.wait(0.15)
end
end
end
end

